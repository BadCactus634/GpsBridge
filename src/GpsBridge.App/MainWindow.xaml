<Window Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="12" x:Class="GpsBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="GpsBridge" Width="1280" Height="820" MinWidth="1000" MinHeight="640" Icon="Assets/icon/icon.ico">
    <DockPanel>
        <!-- ============ testata ============ -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="LedRec" Width="10" Height="10" Fill="{DynamicResource Thumb}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtRec" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" Margin="0,0,10,0" Text="REC fermo"/>
                    <Button x:Name="BtnRecMain" Style="{StaticResource Primary}" Click="BtnRecMain_Click" MinWidth="96"/>
                    <Button x:Name="BtnRecStop" Click="BtnRecStop_Click" IsEnabled="False" MinWidth="80"/>
                    <Rectangle Width="1" Fill="{DynamicResource Line}" Margin="10,2"/>
                    <Button x:Name="BtnEarth" Content="Apri in Google Earth" Click="BtnEarth_Click" IsEnabled="False"/>
                    <Button x:Name="BtnAbout" Click="BtnAbout_Click" ToolTip="Versione, crediti e aggiornamenti"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="GPS" FontFamily="{StaticResource Mono}" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource Accent}"/>
                    <TextBlock Text="BRIDGE" FontFamily="{StaticResource Mono}" FontWeight="Bold" FontSize="18" Margin="0,0,18,0"/>
                    <Ellipse x:Name="LedConn" Width="10" Height="10" Fill="{DynamicResource Amber}" Margin="0,0,8,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtConn" FontWeight="SemiBold" Text="Ricerca del ricevitore..."/>
                        <TextBlock x:Name="TxtSub" Foreground="{DynamicResource Dim}" FontSize="10.5" Text=" "/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ avviso aggiornamento ============ -->
        <Border x:Name="UpdateBanner" DockPanel.Dock="Top" Visibility="Collapsed" Background="{DynamicResource Hi}" BorderBrush="{DynamicResource Accent}" BorderThickness="0,0,0,1" Padding="14,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnUpdNow" Content="Scarica e installa" Style="{StaticResource Primary}" Click="BtnUpdNow_Click"/>
                    <Button x:Name="BtnUpdNotes" Content="Novità" Click="BtnUpdNotes_Click"/>
                    <Button x:Name="BtnUpdSkip" Content="Salta questa versione" Click="BtnUpdSkip_Click"/>
                    <Button x:Name="BtnUpdLater" Content="Più tardi" Click="BtnUpdLater_Click"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtUpdate" FontWeight="SemiBold"/>
                    <ProgressBar x:Name="PbUpd" Height="4" Margin="0,4,0,0" Visibility="Collapsed" Maximum="1" MaxWidth="360" HorizontalAlignment="Left" Foreground="{DynamicResource Accent}" Background="{DynamicResource Line}" BorderThickness="0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ barra di stato ============ -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="14,4">
            <DockPanel>
                <TextBlock x:Name="SbKml" DockPanel.Dock="Right" Foreground="{DynamicResource Dim}" FontFamily="{StaticResource Mono}" FontSize="11"/>
                <TextBlock x:Name="SbFix" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Dim}"/>
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
            <!-- ============ MAPPA ============ -->
            <TabItem Header="MAPPA">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="285"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Margin="8,8,0,8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="POSIZIONE" Style="{StaticResource Cap}" Margin="0,0,0,1"/>
                                <TextBlock x:Name="InPos" Style="{StaticResource Val}" Text="—" TextWrapping="Wrap"/>
                                <UniformGrid Columns="2">
                                    <StackPanel><TextBlock Text="QUOTA" Style="{StaticResource Cap}"/><TextBlock x:Name="InAlt" Style="{StaticResource Val}" Text="—"/></StackPanel>
                                    <StackPanel><TextBlock Text="VELOCITA'" Style="{StaticResource Cap}"/><TextBlock x:Name="InSpd" Style="{StaticResource Val}" Text="—"/></StackPanel>
                                    <StackPanel><TextBlock Text="ROTTA" Style="{StaticResource Cap}"/><TextBlock x:Name="InHdg" Style="{StaticResource Val}" Text="—"/></StackPanel>
                                    <StackPanel><TextBlock Text="FIX" Style="{StaticResource Cap}"/><TextBlock x:Name="InFix" Style="{StaticResource Val}" Text="—"/></StackPanel>
                                    <StackPanel><TextBlock Text="HDOP" Style="{StaticResource Cap}"/><TextBlock x:Name="InDop" Style="{StaticResource Val}" Text="—"/></StackPanel>
                                    <StackPanel><TextBlock Text="SATELLITI" Style="{StaticResource Cap}"/><TextBlock x:Name="InSat" Style="{StaticResource Val}" Text="—"/></StackPanel>
                                </UniformGrid>
                                <TextBlock Text="ORA UTC" Style="{StaticResource Cap}"/>
                                <TextBlock x:Name="InUtc" Style="{StaticResource Val}" Text="—"/>

                                <Rectangle Height="1" Fill="{DynamicResource Line}" Margin="0,14,0,0"/>
                                <TextBlock Text="NAVIGAZIONE" Style="{StaticResource Sect}"/>
                                <TextBlock x:Name="NavName" Text="Nessuna destinazione" Foreground="{DynamicResource Dim}"/>
                                <UniformGrid Columns="2">
                                    <StackPanel><TextBlock Text="DISTANZA" Style="{StaticResource Cap}"/><TextBlock x:Name="NavDist" Style="{StaticResource Val}" Text="—"/></StackPanel>
                                    <StackPanel><TextBlock Text="RILEVAMENTO" Style="{StaticResource Cap}"/><TextBlock x:Name="NavBrg" Style="{StaticResource Val}" Text="—"/></StackPanel>
                                    <StackPanel><TextBlock Text="GIRA DI" Style="{StaticResource Cap}"/><TextBlock x:Name="NavRel" Style="{StaticResource Val}" Text="—"/></StackPanel>
                                    <StackPanel><TextBlock Text="ARRIVO TRA" Style="{StaticResource Cap}"/><TextBlock x:Name="NavEta" Style="{StaticResource Val}" Text="—"/></StackPanel>
                                </UniformGrid>
                                <Button x:Name="BtnNavOff" Content="Annulla navigazione" Click="BtnNavOff_Click" IsEnabled="False" Margin="0,8,0,0"/>

                                <Rectangle Height="1" Fill="{DynamicResource Line}" Margin="0,14,0,0"/>
                                <TextBlock Text="AZIONI" Style="{StaticResource Sect}"/>
                                <Button x:Name="BtnMarkMap" Style="{StaticResource Primary}" Click="BtnMark_Click"/>
                                <Button Content="Copia coordinate" Click="BtnCopy_Click"/>
                                <TextBlock Text="Tasto destro sulla mappa = nuovo punto in quel luogo." Foreground="{DynamicResource Dim}" FontSize="10.5" TextWrapping="Wrap" Margin="3,6,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <DockPanel Grid.Column="1" Margin="8">
                        <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1,1,1,0" Padding="6,4">
                            <DockPanel>
                                <Button x:Name="BtnFollow" DockPanel.Dock="Right" Style="{StaticResource Primary}" Click="BtnFollow_Click"/>
                                <TextBlock DockPanel.Dock="Left" Text="LIVELLO" Style="{StaticResource Cap}" VerticalAlignment="Center" Margin="4,0,8,0"/>
                                <ComboBox x:Name="CmbLayer" Width="230" HorizontalAlignment="Left" SelectionChanged="CmbLayer_SelectionChanged"/>
                            </DockPanel>
                        </Border>
                        <TextBlock x:Name="TxtMapMsg" DockPanel.Dock="Bottom" Padding="6" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{DynamicResource Bad}"/>
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="1"><wv:WebView2 x:Name="Web"/></Border>
                    </DockPanel>
                </Grid>
            </TabItem>
            <!-- ============ PUNTI ============ -->
            <TabItem Header="PUNTI">
                <DockPanel Margin="8">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button x:Name="BtnMarkTab" Style="{StaticResource Primary}" Click="BtnMark_Click"/>
                        <Button Content="Nuovo da coordinate" Click="BtnNewWp_Click"/>
                        <Rectangle Width="1" Fill="{DynamicResource Line}" Margin="8,2"/>
                        <Button Content="Modifica" Click="BtnEditWp_Click"/>
                        <Button Content="Vai a" Click="BtnGoWp_Click"/>
                        <Button Content="Mostra sulla mappa" Click="BtnShowWp_Click"/>
                        <Button Content="Copia coordinate" Click="BtnCopyWp_Click"/>
                        <Button Content="Elimina" Style="{StaticResource Danger}" Click="BtnDelWp_Click"/>
                        <Rectangle Width="1" Fill="{DynamicResource Line}" Margin="8,2"/>
                        <Button Content="Importa GPX..." Click="BtnImportWp_Click"/>
                        <Button Content="Esporta GPX..." Click="BtnExportWp_Click"/>
                        <Button Content="Mostra in Google Earth" Click="BtnWpEarth_Click"/>
                    </WrapPanel>
                    <DataGrid x:Name="GridWp" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MouseDoubleClick="GridWp_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="34">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><Ellipse Width="14" Height="14" Fill="{Binding Brush}" Stroke="{DynamicResource Text}" StrokeThickness="1" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="NOME" Binding="{Binding Name}" Width="190"/>
                            <DataGridTextColumn Header="COORDINATE" Binding="{Binding Coord}" Width="260"/>
                            <DataGridTextColumn Header="QUOTA" Binding="{Binding Ele}" Width="80"/>
                            <DataGridTextColumn Header="DISTANZA" Binding="{Binding Dist}" Width="100"/>
                            <DataGridTextColumn Header="RILEV." Binding="{Binding Bearing}" Width="90"/>
                            <DataGridTextColumn Header="NOTE" Binding="{Binding Notes}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============ TRACCIA ============ -->
            <TabItem Header="TRACCIA">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="REGISTRAZIONE" Style="{StaticResource Sect}" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TrStatus" Text="Registrazione ferma" TextWrapping="Wrap"/>
                                <WrapPanel Margin="0,6,0,0">
                                    <Button x:Name="BtnRecMain2" Style="{StaticResource Primary}" Click="BtnRecMain_Click" MinWidth="96"/>
                                    <Button x:Name="BtnRecStop2" Click="BtnRecStop_Click" IsEnabled="False"/>
                                </WrapPanel>
                                <TextBlock Text="TRACCE SALVATE" Style="{StaticResource Sect}"/>
                            </StackPanel>
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <Button Content="Carica GPX..." Style="{StaticResource Primary}" Click="BtnLoad_Click"/>
                                <Button Content="Mostra" Click="BtnShowTrack_Click"/>
                                <Button Content="Cartella" Click="BtnOpenDir_Click"/>
                                <Button Content="Cancella traccia dalla mappa" Click="BtnClearTrack_Click"/>
                            </WrapPanel>
                            <ListBox x:Name="TrList" MouseDoubleClick="TrList_DoubleClick"/>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock x:Name="TrName" DockPanel.Dock="Top" FontWeight="Bold" FontSize="14" Text="Nessuna traccia mostrata"/>
                            <TextBlock x:Name="TrStats" DockPanel.Dock="Top" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource Accent}" Margin="0,8,0,8" LineHeight="20"/>
                            <TextBlock Text="PROFILO ALTIMETRICO" DockPanel.Dock="Top" Style="{StaticResource Cap}"/>
                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Field}" Margin="0,4,0,0">
                                <Canvas x:Name="Profile" ClipToBounds="True" SizeChanged="Profile_SizeChanged"/>
                            </Border>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============ DIAGNOSTICA ============ -->
            <TabItem Header="DIAGNOSTICA">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="400"/></Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,8,0">
                        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8">
                            <StackPanel>
                                <UniformGrid Columns="2">
                                    <TextBlock x:Name="DgFix" FontFamily="{StaticResource Mono}"/><TextBlock x:Name="DgDop" FontFamily="{StaticResource Mono}"/>
                                    <TextBlock x:Name="DgPos" FontFamily="{StaticResource Mono}"/><TextBlock x:Name="DgSpeed" FontFamily="{StaticResource Mono}"/>
                                    <TextBlock x:Name="DgRate" FontFamily="{StaticResource Mono}"/><TextBlock x:Name="DgErr" FontFamily="{StaticResource Mono}"/>
                                </UniformGrid>
                                <TextBlock x:Name="DgVer" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource Dim}" FontFamily="{StaticResource Mono}"/>
                            </StackPanel>
                        </Border>
                        <DataGrid x:Name="GridConst" DockPanel.Dock="Top" Height="140" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="COSTELLAZIONE" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="USATI" Binding="{Binding Used}"/>
                                <DataGridTextColumn Header="VISTI" Binding="{Binding InView}"/>
                                <DataGridTextColumn Header="SNR MEDIO" Binding="{Binding AvgSnr, StringFormat=0.0}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid x:Name="GridSats" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="0,8,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SISTEMA" Binding="{Binding Constellation}"/>
                                <DataGridTextColumn Header="PRN" Binding="{Binding Prn}"/>
                                <DataGridTextColumn Header="ELEV." Binding="{Binding Elev}"/>
                                <DataGridTextColumn Header="AZIM." Binding="{Binding Azim}"/>
                                <DataGridTextColumn Header="SNR" Binding="{Binding Snr}"/>
                                <DataGridCheckBoxColumn Header="USATO" Binding="{Binding Used, Mode=OneWay}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="CIELO" Style="{StaticResource Sect}" Margin="0,0,0,4"/>
                            <Canvas x:Name="Sky" Width="360" Height="360"/>
                            <WrapPanel Margin="0,8,0,0">
                                <TextBlock Text="●GPS  " Foreground="SteelBlue"/><TextBlock Text="●Galileo  " Foreground="DarkOrange"/>
                                <TextBlock Text="●BeiDou  " Foreground="Crimson"/><TextBlock Text="●GLONASS  " Foreground="SeaGreen"/><TextBlock Text="●QZSS" Foreground="MediumPurple"/>
                            </WrapPanel>
                            <TextBlock Text="Pieno = usato nel fix, vuoto = solo visto." Foreground="{DynamicResource Dim}" FontSize="10.5"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============ IMPOSTAZIONI ============ -->
            <TabItem Header="IMPOSTAZIONI">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="PROGRAMMA" Style="{StaticResource Sect}" Margin="0,0,0,2"/>
                                <TextBlock Text="PORTA DEL RICEVITORE (vuoto = automatica)" Style="{StaticResource Cap}"/>
                                <ComboBox x:Name="CmbRealPort" IsEditable="True"/>
                                <TextBlock Text="BAUD DEL RICEVITORE" Style="{StaticResource Cap}"/>
                                <ComboBox x:Name="CmbRealBaud"><ComboBoxItem Content="Automatico"/><ComboBoxItem Content="4800"/><ComboBoxItem Content="9600"/><ComboBoxItem Content="38400"/><ComboBoxItem Content="115200"/><ComboBoxItem Content="230400"/></ComboBox>
                                <TextBlock Text="TEMA" Style="{StaticResource Cap}"/>
                                <ComboBox x:Name="CmbTheme" SelectionChanged="CmbTheme_SelectionChanged"><ComboBoxItem Content="Scuro"/><ComboBoxItem Content="Chiaro (per la luce del sole)"/><ComboBoxItem Content="Automatico (come Windows)"/></ComboBox>
                                <TextBlock Text="UNITA'" Style="{StaticResource Cap}"/>
                                <ComboBox x:Name="CmbUnits"><ComboBoxItem Content="Metriche (km, km/h, m)"/><ComboBoxItem Content="Imperiali (mi, mph, ft)"/><ComboBoxItem Content="Nautiche (NM, nodi, m)"/></ComboBox>
                                <TextBlock Text="FORMATO COORDINATE" Style="{StaticResource Cap}"/>
                                <ComboBox x:Name="CmbCoord"><ComboBoxItem Content="Gradi decimali (45.5565, 10.2350)"/><ComboBoxItem Content="Gradi, minuti, secondi (DMS)"/><ComboBoxItem Content="Gradi e minuti decimali (DDM)"/><ComboBoxItem Content="UTM"/></ComboBox>
                                <TextBlock Text="CARTELLA TRACCE GPX" Style="{StaticResource Cap}"/>
                                <TextBox x:Name="TxtGpxDir"/>
                                <TextBlock Text="FILTRO PUNTI FERMI (metri)" Style="{StaticResource Cap}"/>
                                <TextBox x:Name="TxtMinMove" Width="100" HorizontalAlignment="Left"/>
                                <TextBlock Text="CACHE MAPPA (MB)" Style="{StaticResource Cap}"/>
                                <TextBox x:Name="TxtTileMb" Width="100" HorizontalAlignment="Left"/>

                                <TextBlock Text="GOOGLE EARTH" Style="{StaticResource Sect}"/>
                                <CheckBox x:Name="ChkKml" Content="Posizione live via KML (nessun driver)"/>
                                <CheckBox x:Name="ChkKmlFollow" Content="Earth segue la posizione"/>
                                <TextBlock Text="PORTA LOCALE DEL SERVER KML" Style="{StaticResource Cap}"/>
                                <TextBox x:Name="TxtKmlPort" Width="100" HorizontalAlignment="Left"/>

                                <TextBlock Text="AVVIO" Style="{StaticResource Sect}"/>
                                <CheckBox x:Name="ChkAutoRec" Content="Avvia la registrazione GPX all'apertura"/>
                                <CheckBox x:Name="ChkWinStart" Content="Avvia con Windows"/>
                                <CheckBox x:Name="ChkUpdates" Content="Controlla gli aggiornamenti all'avvio (contatta solo github.com)"/>
                                <CheckBox x:Name="ChkApplyOnConnect" Content="Applica la configurazione del ricevitore a ogni connessione"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Salva impostazioni" Style="{StaticResource Primary}" Click="BtnSaveSettings_Click"/>
                                    <Button Content="Svuota cache mappa" Click="BtnClearTiles_Click"/>
                                </WrapPanel>
                                <TextBlock x:Name="TxtProgramMsg" TextWrapping="Wrap" Margin="3,6,0,0" Foreground="{DynamicResource Good}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="RICEVITORE GPS (u-blox M10)" Style="{StaticResource Sect}" Margin="0,0,0,2"/>
                                <TextBlock Text="COSTELLAZIONI" Style="{StaticResource Cap}"/>
                                <WrapPanel>
                                    <CheckBox x:Name="ChkGps" Content="GPS" Margin="0,3,14,3"/><CheckBox x:Name="ChkGal" Content="Galileo" Margin="0,3,14,3"/>
                                    <CheckBox x:Name="ChkBds" Content="BeiDou (B1C)" Margin="0,3,14,3"/><CheckBox x:Name="ChkGlo" Content="GLONASS" Margin="0,3,14,3"/>
                                    <CheckBox x:Name="ChkQzss" Content="QZSS" Margin="0,3,14,3"/><CheckBox x:Name="ChkSbas" Content="SBAS" Margin="0,3,14,3"/>
                                </WrapPanel>
                                <TextBlock x:Name="TxtCaps" TextWrapping="Wrap" Foreground="{DynamicResource Dim}" FontSize="11" Margin="0,2,0,0"/>
                                <TextBlock Text="FREQUENZA DI AGGIORNAMENTO (Hz)" Style="{StaticResource Cap}"/>
                                <ComboBox x:Name="CmbRate"><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="5"/><ComboBoxItem Content="10"/></ComboBox>
                                <TextBlock Text="MODELLO DINAMICO" Style="{StaticResource Cap}"/>
                                <ComboBox x:Name="CmbDyn"><ComboBoxItem Content="Portatile"/><ComboBoxItem Content="Pedone"/><ComboBoxItem Content="Auto"/><ComboBoxItem Content="Fermo"/><ComboBoxItem Content="Aereo"/></ComboBox>
                                <TextBlock Text="FRASI NMEA IN USCITA" Style="{StaticResource Cap}"/>
                                <WrapPanel>
                                    <CheckBox x:Name="ChkGga" Content="GGA" Margin="0,3,14,3"/><CheckBox x:Name="ChkRmc" Content="RMC" Margin="0,3,14,3"/>
                                    <CheckBox x:Name="ChkGsa" Content="GSA" Margin="0,3,14,3"/><CheckBox x:Name="ChkGsv" Content="GSV" Margin="0,3,14,3"/>
                                    <CheckBox x:Name="ChkVtg" Content="VTG" Margin="0,3,14,3"/><CheckBox x:Name="ChkGll" Content="GLL" Margin="0,3,14,3"/>
                                </WrapPanel>
                                <TextBlock Text="BAUD UART DEL RICEVITORE (cambialo solo se serve)" Style="{StaticResource Cap}"/>
                                <ComboBox x:Name="CmbUartBaud"><ComboBoxItem Content="Non toccare"/><ComboBoxItem Content="9600"/><ComboBoxItem Content="38400"/><ComboBoxItem Content="115200"/><ComboBoxItem Content="230400"/></ComboBox>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Applica profilo migliore (flash)" Style="{StaticResource Primary}" Click="BtnApplyBest_Click"/>
                                    <Button Content="Salva queste opzioni in flash" Click="BtnSaveFlash_Click"/>
                                    <Button Content="Prova solo in RAM" Click="BtnApplyRam_Click"/>
                                    <Button Content="Leggi dal ricevitore" Click="BtnReadRx_Click"/>
                                    <Button Content="Ripristina predefiniti u-blox" Style="{StaticResource Danger}" Click="BtnResetRx_Click"/>
                                </WrapPanel>
                                <TextBox x:Name="TxtRxLog" Height="200" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
